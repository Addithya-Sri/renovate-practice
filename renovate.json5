
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Alpine packages",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=apk\\s+depName=(?<depName>\\S+)\\s+registryUrl=(?<registryUrl>\\S+)\\s+ENV\\s+[A-Z0-9_]+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "apk",
      "versioningTemplate": "apk"
    }
  ],

  "packageRules": [
    {
      "matchDatasources": ["docker", "apk"],
      "matchPackageNames": [
        "library/alpine",
        "catatonit",
        "bash",
        "shadow",
        "openssh-sftp-server",
        "inotify-tools"
      ],
      "groupName": "Alpine base image and packages",
      "separateMajorMinor": false,
      "recreateWhen": "always"
    }
  ]
}
