{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Update Alpine distribution",
      managerFilePatterns: ["/^Dockerfile$/"],
      matchStrings: [
        "registryUrl=https://dl-cdn\\.alpinelinux\\.org/alpine\\?branch=v(?<currentValue>\\d+\\.\\d+)",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "library/alpine",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$",
      autoReplaceStringTemplate: "registryUrl=https://dl-cdn.alpinelinux.org/alpine?branch=v{{{newMajor}}}.{{{newMinor}}}",
    },
    {
      customType: "regex",
      description: "Update Alpine packages",
      managerFilePatterns: ["/^Dockerfile$/"],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>.*?) depName=(?<depName>.*?)( registryUrl=(?<registryUrl>.*?))?( versioning=(?<versioning>.*?))?\\sENV .*?_VERSION="(?<currentValue>.*)"\\s',
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}apk{{/if}}",
    },
  ],
}
